<div class="topbar"><h1><%- include('includes/_icon', {icon:'file-text'}) %> <%= t('txs.title') %></h1></div>

<div class="filterbar">
  <form action="/tx" method="get">
    <input class="blocks-q" type="text" name="q" value="<%= q||'' %>" placeholder="<%= t('txs.lookupPlaceholder') %>" spellcheck="false" autocomplete="off">
    <button class="btn" type="submit"><%= t('txs.lookup') %></button>
  </form>
</div>

<% if (invalid) { %><div class="error"><%= t('txs.invalid') %></div><% } %>

<% if (usedFallback && fallback && fallback.length) { %>
  <p class="muted"><%= t('txs.fallbackNote') %></p>
<% } else if (typeof partialFallback !== 'undefined' && partialFallback) { %>
  <p class="muted"><%= t('txs.partialNote') %></p>
<% } %>

<% if (groups && groups.length) { %>
  <% groups.forEach(g => { %>
  <div class="panel">
    <h2>
      <%- include('includes/_icon', {icon:'blocks'}) %>
      <a href="/block/<%= g.hash %>"><%= t('txs.block', { n: nfmt(g.height) }) %></a>
    </h2>
    <table>
      <thead><tr><th><%= t('txs.txid') %></th><th><%= t('blocks.nameOps') %></th></tr></thead>
      <tbody>
        <% (g.tx||[]).forEach(txid => { const id = typeof txid === 'string' ? txid : (txid && txid.txid); %>
        <% if (id) { %>
        <tr class="row-link" data-href="/tx/<%= id %>">
          <td class="mono"><a class="row-link-hit" href="/tx/<%= id %>" title="<%= id %>"><%= id %></a></td>
          <td><% const n = ((typeof opsByTxid !== 'undefined' && opsByTxid && opsByTxid[String(id).toLowerCase()]) || []).length; %><%= n ? nfmt(n) : '—' %></td>
        </tr>
        <% } %>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% }) %>
<% } else if (fallback && fallback.length) { %>
  <div class="panel">
    <h2><%- include('includes/_icon', {icon:'file-text'}) %> <%= t('txs.recent') %></h2>
    <table>
      <thead><tr><th><%= t('txs.txid') %></th><th><%= t('home.height') %></th><th><%= t('blocks.nameOps') %></th></tr></thead>
      <tbody>
        <% fallback.forEach(o => { %>
        <tr class="row-link" data-href="/tx/<%= o.txid %>">
          <td class="mono"><a class="row-link-hit" href="/tx/<%= o.txid %>" title="<%= o.txid %>"><%= o.txid %></a></td>
          <td><% if (o.height != null) { %><a href="/block/<%= o.height %>"><%= nfmt(o.height) %></a><% } else { %>—<% } %></td>
          <td><% const n = ((typeof opsByTxid !== 'undefined' && opsByTxid && opsByTxid[String(o.txid).toLowerCase()]) || []).length; %><%= n ? nfmt(n) : '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="panel"><p class="muted"><%= t('txs.empty') %></p></div>
<% } %>
