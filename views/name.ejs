<div class="topbar">
  <h1 class="mono"><%= name %></h1>
</div>

<% if (typeof nameError !== 'undefined' && nameError && nameError.toLowerCase().includes('expired')) { %>
  <div class="error"><%= t('name.expiredBanner') %></div>
<% } else if (typeof nameError !== 'undefined' && nameError) { %>
  <div class="error"><%= nameError %></div>
<% } %>

<% if (show) { %>
<% const ek = expiryKind(show); const rec = typeof record !== 'undefined' && record ? record : {}; %>
<div class="panel record-card">
  <h2>
    <%- include('includes/_icon', {icon:'database'}) %> <%= t('name.currentRecord') %>
    <span class="pill <%= ek==='expired'?'red':ek==='expiring'?'yellow':'green' %> record-status"><%= t('status.' + ek) %></span>
  </h2>
  <div class="record-grid">
    <div class="record-field">
      <span class="l"><%= t('name.name') %></span>
      <span class="v mono"><%= show.name %></span>
    </div>
    <div class="record-field">
      <span class="l"><%= t('name.owner') %></span>
      <span class="v mono"><% if (show.address) { %><a href="/tx/<%= show.txid %>" title="<%= show.address %>"><%= shortId(show.address) %></a><% } else { %>—<% } %></span>
    </div>
    <div class="record-field">
      <span class="l"><%= t('name.updatedAt') %></span>
      <span class="v"><%= rec.updateTs ? fmtUtc(rec.updateTs, lang) : '—' %></span>
      <span class="s"><% const ru = rec.updateTs ? relDur(rec.updateTs) : null; %><% if (ru) { %><%= rec.updateApprox ? t('time.approx') + ' ' : '' %><%= t(ru.future ? 'time.in' : 'time.ago', { t: ru.t }) %> · <% } %><%= t('name.height', { n: nfmt(show.height) }) %></span>
    </div>
    <div class="record-field">
      <span class="l"><%= t('name.expires') %></span>
      <span class="v"><%= rec.expiresTs ? fmtUtc(rec.expiresTs, lang) : '—' %></span>
      <span class="s"><% const re = rec.expiresTs ? relDur(rec.expiresTs) : null; %><% if (re) { %><%= rec.expiresApprox ? t('time.approx') + ' ' : '' %><%= t(re.future ? 'time.in' : 'time.ago', { t: re.t }) %> · <% } %><%= t('name.blocks', { n: nfmt(show.expires_in) }) %></span>
    </div>
    <div class="record-field record-span">
      <span class="l"><%= t('name.lastUpdateTx') %></span>
      <span class="v mono"><% if (show.txid) { %><a href="/tx/<%= show.txid %>" title="<%= show.txid %>"><%= shortId(show.txid, 12, 10) %></a><% } else { %>—<% } %></span>
    </div>
  </div>
</div>

  <% if (decoded) { %>
  <div class="panel">
    <h2><%- include('includes/_icon', {icon:'file-text'}) %> <%= t('name.value') %></h2>
    <%- include('includes/_value', { decoded: decoded, fallback: show.value || '' }) %>
  </div>
  <% } %>

  <div class="panel">
    <h2><%- include('includes/_icon', {icon:'activity'}) %> <%= t('name.operationHistory', { n: (history||[]).length }) %></h2>
    <div class="timeline">
      <% (history||[]).forEach(h => { %>
      <% const ot = h.opLabel || h.opType || 'UPDATE'; %>
      <div class="tl-item">
        <div class="tl-rail">
          <span class="tl-dot <%= ot==='REGISTER'||ot==='NEW'?'dot-register':ot==='TRANSFER'?'dot-transfer':ot==='RENEW'?'dot-renew':ot.indexOf('UPDATE')>=0?'dot-update':'dot-other' %>"></span>
        </div>
        <div class="tl-content">
          <div class="tl-head">
            <span class="pill <%= ot==='NEW'?'purple':ot==='REGISTER'?'blue':ot==='TRANSFER'?'pink':ot==='RENEW'?'cyan':ot.indexOf('UPDATE')>=0?'yellow':'gray' %>" title="<%= h.opTitle || '' %>"><%= ot %></span>
            <span class="tl-date"><%= h.dateStr ? new Date(h.dateStr).toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'}) : '—' %>
              <% if (h.dateStr) { %><span class="dim">· <%= new Date(h.dateStr).toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'}) %> UTC</span><% } %></span>
            <span class="tl-height">blk <%= nfmt(h.height) %></span>
          </div>
          <div class="tl-body">
            <% if (h.address) { %>→ <a href="/tx/<%= h.txid||'#' %>" class="mono" title="<%= h.address %>"><%= shortId(h.address) %></a><% } %>
            <% if (h.txid) { %><span class="dim">· <a href="/tx/<%= h.txid %>" class="mono" title="<%= h.txid %>"><%= shortId(h.txid, 12, 8) %></a></span><% } %>
            <% if (h.inferred) { %><span class="pill gray" style="font-size:10px"><%= t('name.inferred') %></span><% } %>
          </div>
          <% if (h.value) { const hv = renderValue({ value: h.value }); %>
          <% if (hv && hv.kind !== 'empty') { %>
          <div class="tl-value-block">
            <span class="l"><%= t('name.value') %></span>
            <%- include('includes/_value', { decoded: hv, compact: true }) %>
          </div>
          <% } %>
          <% } %>
        </div>
      </div>
      <% }) %>
      <% if (!history || history.length===0) { %><p class="muted"><%= t('name.noHistory') %></p><% } %>
    </div>
  </div>

<% } else { %>
  <div class="error"><%= t('name.noRecord') %></div>
<% } %>

<% if (pending && pending.length) { %>
<div class="panel">
  <h2><%- include('includes/_icon', {icon:'activity'}) %> <%= t('name.pendingOps') %></h2>
  <table>
    <thead><tr><th><%= t('name.name') %></th><th><%= t('name.op') %></th><th><%= t('name.value') %></th></tr></thead>
    <tbody>
      <% pending.forEach(p => { %>
      <tr><td class="mono"><%= p.name %></td><td><%= p.op %></td><td class="mono"><%= String(p.value||'').slice(0,60) %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
