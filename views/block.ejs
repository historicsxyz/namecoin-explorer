<div class="topbar">
  <h1 class="mono">Block #<%= (block && block.height != null) ? nfmt(block.height) : '' %></h1>
  <span class="crumb"><a href="/blocks"><%= t('block.back') %></a></span>
</div>

<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
<% if (typeof fromCache !== 'undefined' && fromCache) { %><p class="muted"><%= t('block.cacheNote') %></p><% } %>

<% if (block) { %>
<div class="panel">
  <h2><%- include('includes/_icon', {icon:'blocks'}) %> <%= t('block.header') %></h2>
  <dl class="dl">
    <dt><%= t('block.hash') %></dt><dd class="mono"><%= block.hash %></dd>
    <dt><%= t('block.height') %></dt><dd><%= nfmt(block.height) %></dd>
    <dt><%= t('block.time') %></dt><dd><%- include('includes/_when', { unix: block.time }) %></dd>
    <% if (block.previousblockhash) { %><dt><%= t('block.previous') %></dt><dd><a href="/block/<%= block.previousblockhash %>" class="mono"><%= block.previousblockhash.slice(0,24) %>…</a></dd><% } %>
    <% if (block.nextblockhash) { %><dt><%= t('block.next') %></dt><dd><a href="/block/<%= block.nextblockhash %>" class="mono"><%= block.nextblockhash.slice(0,24) %>…</a></dd><% } %>
    <dt><%= t('block.transactions') %></dt><dd><%= block.nTx != null ? nfmt(block.nTx) : '—' %></dd>
    <dt><%= t('block.nameOpsInBlock') %></dt><dd><%= block._nameOpCount||0 %></dd>
    <% if (block.size != null) { %><dt><%= t('block.size') %></dt><dd class="mono"><%= bytesOnDisk(block.size) %></dd><% } %>
    <% if (block.weight != null) { %><dt><%= t('block.weight') %></dt><dd class="mono"><%= nfmt(block.weight) %></dd><% } %>
    <% if (block.difficulty != null) { %><dt><%= t('block.difficulty') %></dt><dd class="mono" title="<%= block.difficulty %>"><%= formatDifficulty(block.difficulty) %></dd><% } %>
    <% if (block.bits != null) { %><dt><%= t('block.bits') %></dt><dd class="mono"><%= block.bits %></dd><% } %>
    <% if (block.version != null) { %><dt><%= t('block.version') %></dt><dd class="mono"><%= block.version %></dd><% } %>
    <% if (block._coinbaseNmc != null) { %><dt><%= t('block.coinbase') %></dt><dd class="mono"><%= fmtNmc(block._coinbaseNmc) %></dd><% } %>
    <% if (block._parentBitcoinHash) { %><dt><%= t('block.bitcoinParent') %></dt><dd class="mono"><%= block._parentBitcoinHash %></dd><% } %>
    <dt><%= t('block.merkleRoot') %></dt><dd class="mono"><%= block.merkleroot %></dd>
    <% if (block.nonce!=null) { %><dt><%= t('block.nonce') %></dt><dd><%= block.nonce %></dd><% } %>
  </dl>
</div>

  <% if (block._nameOpCount > 0) { %>
  <div class="panel">
    <h2><%- include('includes/_icon', {icon:'activity'}) %> <%= t('block.nameOpsHeading', { n: block._nameOpCount }) %></h2>
    <table>
      <thead><tr><th><%= t('block.operation') %></th><th><%= t('block.name') %></th><th><%= t('block.value') %></th><th><%= t('block.tx') %></th></tr></thead>
      <tbody>
        <% (block.tx||[]).forEach(tx => { %>
          <% (tx._nameOps||[]).forEach(o => { %>
          <tr>
            <td><%- include('includes/_op-pill', { op: o.op }) %></td>
            <td class="mono"><% if (o.name) { %><a href="/name/<%= encodeURIComponent(o.name) %>"><%= o.name %></a><% } else { %><span class="muted"><%= t('ops.hiddenName') %></span><% } %></td>
            <td class="mono" style="max-width:220px;overflow:hidden;text-overflow:ellipsis" title="<%= String(o.value||'') %>"><%= valuePreview(o.value) %></td>
            <td class="mono"><a href="/tx/<%= tx.txid %>"><%= tx.txid.slice(0,14) %>…</a></td>
          </tr>
          <% }) %>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <% if ((block.tx||[]).length) { %>
  <div class="panel">
    <h2><%- include('includes/_icon', {icon:'file-text'}) %> <%= t('block.txHeading', { n: (typeof fromCache !== 'undefined' && fromCache) ? (block.tx||[]).length : block.nTx }) %></h2>
    <table>
      <thead><tr><th><%= t('block.txid') %></th><th><%= t('block.inputs') %></th><th><%= t('block.outputs') %></th><th><%= t('block.containsNameOp') %></th></tr></thead>
      <tbody>
        <% (block.tx||[]).forEach(tx => { %>
        <tr>
          <td class="mono"><a href="/tx/<%= tx.txid %>"><%= tx.txid.slice(0,24) %>…</a></td>
          <td><% if (tx.vin == null) { %>—<% } else { %><%= (tx.vin||[]).length %><% } %></td>
          <td><% if (tx.vout == null) { %>—<% } else { %><%= (tx.vout||[]).length %><% } %></td>
          <td><% if (tx._nameOps && tx._nameOps.length) { %><span class="pill blue"><%= t('block.yes', { n: tx._nameOps.length }) %></span><% } else { %><span class="dim"><%= t('block.no') %></span><% } %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else if (typeof fromCache !== 'undefined' && fromCache) { %>
  <p class="muted"><%= t('block.txNeedsRpc') %></p>
  <% } %>
<% } %>
