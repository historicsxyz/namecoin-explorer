<div class="topbar"><h1><%- include('includes/_icon', {icon:'blocks'}) %> <%= t('blocks.title') %></h1></div>

<div class="panel">
  <table>
    <thead><tr><th><%= t('blocks.height') %></th><th><%= t('blocks.hash') %></th><th><%= t('blocks.time') %></th><th><%= t('blocks.txs') %></th><th><%= t('blocks.nameOps') %></th></tr></thead>
    <tbody>
      <% (blocks||[]).forEach(b => { %>
      <tr>
        <td><a href="/block/<%= b.hash %>"><%= nfmt(b.height) %></a></td>
        <td class="hash"><a href="/block/<%= b.hash %>"><%= b.hash.slice(0,22) %>…</a></td>
        <td class="mono" style="font-size:11px;color:var(--dim)"><%= new Date(b.time*1000).toLocaleString() %></td>
        <td><%= nfmt(b.nTx) %></td>
        <td><%= b._nameOpCount!=null ? b._nameOpCount : '—' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
