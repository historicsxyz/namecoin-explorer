<div class="topbar"><h1 class="mono">ns/<%= ns %></h1></div>

<div class="grid cols-4" style="margin-bottom:18px">
  <div class="stat"><div class="n"><%= nfmt(info.total||0) %></div><div class="l"><%= t('ns.totalNames', { ns: ns }) %></div></div>
  <div class="stat"><div class="n" style="color:var(--green)"><%= nfmt(info.live||0) %></div><div class="l"><%= t('ns.live') %></div></div>
  <div class="stat"><div class="n" style="color:var(--red)"><%= nfmt(info.expired||0) %></div><div class="l"><%= t('ns.expired') %></div></div>
</div>

<div class="filterbar">
  <form action="/namespace/<%= ns %>" method="get">
    <select name="status" onchange="this.form.submit()">
      <option value=""><%= t('ns.allStatus') %></option>
      <option value="live" <%= status==='live'?'selected':'' %>><%= t('ns.live') %></option>
      <option value="expiring" <%= status==='expiring'?'selected':'' %>><%= t('ns.expiringSoon') %></option>
      <option value="expired" <%= status==='expired'?'selected':'' %>><%= t('ns.expired') %></option>
    </select>
  </form>
</div>

<div class="panel">
  <table class="names-table cols-5">
    <thead><tr><th><%= t('ns.name') %></th><th><%= t('ns.value') %></th><th><%= t('ns.updated') %></th><th><%= t('ns.expiresIn') %></th><th><%= t('ns.status') %></th></tr></thead>
    <tbody>
      <% (rows||[]).forEach(r => { %>
      <tr class="row-link" data-href="/name/<%= encodeURIComponent(r.name) %>">
        <td class="mono"><a class="row-link-hit" href="/name/<%= encodeURIComponent(r.name) %>" title="<%= r.name %>"><%= r.name || '—' %></a></td>
        <td class="mono" style="max-width:240px;overflow:hidden;text-overflow:ellipsis"><%= (r.value||'').slice(0,40) %></td>
        <td><%= nfmt(r.height) %></td>
        <td class="mono"><%= r.expires_in!=null?nfmt(r.expires_in):'—' %></td>
        <td><% const ek = expiryKind(r); %><span class="pill <%= ek==='expired'?'red':ek==='expiring'?'yellow':'green' %>"><%= t('status.' + ek) %></span></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <div class="pager">
    <% if (rows && rows.length>=limit) { %>
      <a class="btn" rel="next" href="/namespace/<%= encodeURIComponent(ns) %>?start=<%= encodeURIComponent(rows[rows.length-1].name) %>&limit=<%= limit %><%= status?'&status='+encodeURIComponent(status):'' %>"><%= t('ns.next') %></a>
    <% } %>
  </div>
</div>
