<section class="hero">
  <h1><%- include('includes/_icon', {icon:'compass'}) %> <%= t('home.title') %></h1>
</section>

<div class="grid cols-4">
  <div class="stat"><%- include('includes/_icon', {icon:'blocks'}) %><div class="n"><%= latest ? nfmt(latest) : '—' %></div><div class="l"><%= t('home.blockHeight') %></div></div>
  <div class="stat"><%- include('includes/_icon', {icon:'tag'}) %><div class="n" id="st-total"><%= (namespaces||[]).reduce((a,r)=>a+r.total,0) %></div><div class="l"><%= t('home.totalNames') %></div></div>
  <div class="stat"><%- include('includes/_icon', {icon:'check'}) %><div class="n" style="color:var(--green)"><%= (namespaces||[]).reduce((a,r)=>a+(r.live||0),0) %></div><div class="l"><%= t('home.liveNames') %></div></div>
  <div class="stat"><%- include('includes/_icon', {icon:'clock'}) %><div class="n" style="color:var(--red)"><%= (namespaces||[]).reduce((a,r)=>a+(r.expired||0),0) %></div><div class="l"><%= t('home.expired') %></div></div>
</div>

<div class="grid cols-2">
  <div class="panel latest-block">
    <h2>
      <%- include('includes/_icon', {icon:'blocks'}) %> <%= t('home.latestBlock') %>
      <% if (blocks && blocks.length) { %><a class="btn btn-ghost latest-block-link" href="/blocks"><%= t('home.viewAll') %></a><% } %>
    </h2>
    <% if (blocks && blocks.length) { %>
      <div class="lb-clip">
        <div class="timeline lb-timeline">
          <% blocks.forEach(function (block, i) { %>
          <article class="tl-item lb-item<%= i >= 3 ? ' lb-peek' : '' %>"<% if (i >= 3) { %> inert<% } %>>
            <div class="tl-rail">
              <span class="tl-dot<%= i === 0 ? ' dot-register' : '' %>"></span>
            </div>
            <div class="tl-content">
              <a class="lb-main" href="/block/<%= block.hash %>">
                <div class="lb-head">
                  <span class="lb-height"><%= nfmt(block.height) %></span>
                  <span class="lb-ago"><% const ra = relDur(block.time); %><% if (ra) { %><%= t(ra.future ? 'time.in' : 'time.ago', { t: ra.t }) %><% } %></span>
                </div>
                <div class="lb-hash mono" title="<%= block.hash %>"><%= block.hash %></div>
              </a>
              <div class="lb-meta">
                <span title="<%= t('home.transactions') %>"><strong><%= block.nTx != null ? nfmt(block.nTx) : '—' %></strong> <%= t('home.txAbbr') %></span>
                <span title="<%= t('home.nameOps') %>"><strong><%= nfmt(block.nameOpCount || 0) %></strong> <%= t('home.opsAbbr') %></span>
                <span title="<%= t('home.sincePrev') %>"><strong><%= fmtDuration(block.intervalSec) %></strong></span>
                <% if (block.prev) { %>
                  <a href="/block/<%= block.prev %>" title="<%= t('home.previous') %>"><%= t('home.prevAbbr') %> <%= block.prevHeight != null ? nfmt(block.prevHeight) : block.prev.slice(0, 10) + '…' %></a>
                <% } %>
              </div>
            </div>
          </article>
          <% }) %>
        </div>
      </div>
    <% } else { %><p class="muted"><%= t('home.awaitingBlock') %></p><% } %>
  </div>

  <div class="panel">
    <h2>
      <%- include('includes/_icon', {icon:'layers'}) %> <%= t('home.namespaces') %>
      <% if (namespaces && namespaces.length) { %><a class="btn btn-ghost latest-block-link" href="/namespaces"><%= t('home.viewAll') %></a><% } %>
    </h2>
    <table>
      <thead><tr><th><%= t('home.prefix') %></th><th><%= t('home.total') %></th><th><%= t('home.live') %></th><th><%= t('home.expired') %></th></tr></thead>
      <tbody>
        <% (namespaces||[]).slice(0,8).forEach(r => { %>
        <tr>
          <td class="mono"><a href="/namespace/<%= r.namespace.replace(/\/$/,'') %>"><%= r.namespace %></a></td>
          <td><%= nfmt(r.total) %></td>
          <td style="color:var(--green)"><%= nfmt(r.live||0) %></td>
          <td style="color:var(--red)"><%= nfmt(r.expired||0) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="grid cols-2">
  <div class="panel">
      <h2><%- include('includes/_icon', {icon:'activity'}) %> <%= t('home.recentlyUpdated') %></h2>
    <table>
      <thead><tr><th><%= t('home.name') %></th><th><%= t('home.height') %></th><th><%= t('home.status') %></th></tr></thead>
      <tbody>
        <% (recent||[]).slice(0,8).forEach(r => { %>
        <tr class="row-link" data-href="/name/<%= encodeURIComponent(r.name) %>">
          <td class="mono"><a class="row-link-hit" href="/name/<%= encodeURIComponent(r.name) %>" title="<%= r.name %>"><%= r.name || '—' %></a></td>
          <td><%= nfmt(r.height) %></td>
          <td><% const ek = expiryKind(r); %><span class="pill <%= ek==='expired'?'red':ek==='expiring'?'yellow':'green' %>"><%= t('status.' + ek) %></span></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="panel">
    <h2><%- include('includes/_icon', {icon:'clock'}) %> <%= t('home.expiringSoon') %></h2>
    <table>
      <thead><tr><th><%= t('home.name') %></th><th><%= t('home.expiresInBlks') %></th></tr></thead>
      <tbody>
        <% (expiring||[]).slice(0,8).forEach(r => { %>
        <tr class="row-link" data-href="/name/<%= encodeURIComponent(r.name) %>">
          <td class="mono"><a class="row-link-hit" href="/name/<%= encodeURIComponent(r.name) %>" title="<%= r.name %>"><%= r.name || '—' %></a></td>
          <td class="mono" style="color:var(--yellow)"><%= nfmt(r.expires_in) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
