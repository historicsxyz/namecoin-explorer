<div class="topbar"><h1><%- include('includes/_icon', {icon:'search'}) %> <%= t('names.title') %></h1></div>

<div class="filterbar">
  <form action="/names" method="get">
    <input type="text" name="q" value="<%= q||'' %>" placeholder="<%= t('names.searchPlaceholder') %>" style="width:220px">
    <select name="ns" onchange="this.form.submit()">
      <option value=""><%= t('names.allNamespaces') %></option>
      <% (namespaces||[]).forEach(n => { %>
        <option value="<%= n.namespace.replace(/\/$/,'') %>" <%= ns===n.namespace.replace(/\/$/,'')?'selected':'' %>><%= n.namespace %> (<%= nfmt(n.total) %>)</option>
      <% }) %>
    </select>
    <select name="status" onchange="this.form.submit()">
      <option value=""><%= t('names.allStatus') %></option>
      <option value="live" <%= status==='live'?'selected':'' %>><%= t('names.live') %></option>
      <option value="expiring" <%= status==='expiring'?'selected':'' %>><%= t('names.expiringSoon') %></option>
      <option value="expired" <%= status==='expired'?'selected':'' %>><%= t('names.expired') %></option>
    </select>
    <button class="btn" type="submit"><%= t('names.filter') %></button>
  </form>
</div>

<div class="panel">
  <table class="names-table">
    <thead><tr><th><%= t('names.name') %></th><th><%= t('names.value') %></th><th><%= t('names.owner') %></th><th><%= t('names.updated') %></th><th><%= t('names.expiresIn') %></th><th><%= t('names.status') %></th></tr></thead>
    <tbody>
      <% (rows||[]).forEach(r => { %>
      <tr class="row-link" data-href="/name/<%= encodeURIComponent(r.name) %>">
        <td class="mono"><a class="row-link-hit" href="/name/<%= encodeURIComponent(r.name) %>" title="<%= r.name %>"><%= r.name || '—' %></a></td>
        <td class="mono" style="max-width:260px;overflow:hidden;text-overflow:ellipsis"><%= (r.value||'').slice(0,50) %></td>
        <td class="mono" style="font-size:11px"><% if (r.address) { %><a href="/address/<%= encodeURIComponent(r.address) %>" title="<%= r.address %>"><%= r.address.slice(0,14)+'…' %></a><% } else { %><span class="dim">—</span><% } %></td>
        <td><%= nfmt(r.height) %></td>
        <td class="mono"><%= r.expires_in!=null?nfmt(r.expires_in):'—' %></td>
        <td><% const ek = expiryKind(r); %><span class="pill <%= ek==='expired'?'red':ek==='expiring'?'yellow':'green' %>"><%= t('status.' + ek) %></span></td>
      </tr>
      <% }) %>
      <% if (!rows || rows.length===0) { %>
        <tr><td colspan="6" class="empty"><%= t('names.noMatch') %></td></tr>
      <% } %>
    </tbody>
  </table>
  <div class="pager">
    <% if (rows && rows.length>=limit) { %>
      <a class="btn" rel="next" href="/names?start=<%= encodeURIComponent(rows[rows.length-1].name) %>&limit=<%= limit %><%= ns?'&ns='+encodeURIComponent(ns):'' %><%= status?'&status='+encodeURIComponent(status):'' %><%= q?'&q='+encodeURIComponent(q):'' %>"><%= t('names.next') %></a>
    <% } %>
    <span class="muted"><%= t('names.shown', { n: rows?.length||0 }) %></span>
  </div>
</div>
