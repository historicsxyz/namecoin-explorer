<div class="topbar">
  <h1><%- include('includes/_icon', {icon:'activity'}) %> <%= t('ops.title') %></h1>
</div>

<%- include('includes/_infonote', { note: t('ops.confirmedNote') }) %>

<div class="filterbar">
  <form action="/operations" method="get">
    <select name="op" onchange="this.form.submit()">
      <option value=""><%= t('ops.all') %></option>
      <option value="NAME_NEW" <%= op==='NAME_NEW'?'selected':'' %>>NAME_NEW</option>
      <option value="NAME_FIRSTUPDATE" <%= op==='NAME_FIRSTUPDATE'?'selected':'' %>><%= t('ops.firstupdate') %></option>
      <option value="NAME_UPDATE" <%= op==='NAME_UPDATE'?'selected':'' %>><%= t('ops.update') %></option>
    </select>
    <% if (typeof limit !== 'undefined' && limit && limit !== 20) { %>
      <input type="hidden" name="limit" value="<%= limit %>">
    <% } %>
    <label class="filterbar-check">
      <input type="checkbox" name="commitments" value="1" <%= (typeof commitments !== 'undefined' && commitments) ? 'checked' : '' %> onchange="this.form.submit()">
      <%= t('ops.showCommitments') %>
    </label>
    <a class="btn btn-ghost" href="/operations/pending"><%= t('ops.pending') %></a>
  </form>
  <div class="filterbar-meta">
    <span><%= t('ops.chainTip', { n: (scanInfo&&scanInfo.tip)||'…' }) %></span>
    <span><%= t('ops.lastOp', { n: (scanInfo&&scanInfo.range)||'…' }) %></span>
    <span><%= t('ops.updated') %> <span data-live-updated><%= now ? new Date(now).toLocaleTimeString() : '' %></span></span>
  </div>
</div>

<div class="panel">
  <table class="ops-table">
    <thead><tr><th><%= t('ops.operation') %></th><th><%= t('ops.name') %></th><th><%= t('ops.value') %></th><th><%= t('ops.block') %></th><th><%= t('ops.tx') %></th><th><%= t('ops.time') %></th></tr></thead>
    <tbody>
      <% (feed||[]).forEach(o => { %>
      <tr>
        <td><%- include('includes/_op-pill', { op: o.displayOp || o.op }) %></td>
        <td class="mono"><a href="/name/<%= encodeURIComponent(o.name||'') %>"><%= o.name || '—' %></a></td>
        <td class="mono" style="max-width:220px;overflow:hidden;text-overflow:ellipsis"><%= String(o.value||'').slice(0,40) %></td>
        <td class="mono"><a href="/block/<%= o.block %>"><%= nfmt(o.block) %></a></td>
        <td class="mono" style="font-size:11px"><a href="/tx/<%= o.txid %>"><%= o.txid?o.txid.slice(0,12)+'…':'' %></a></td>
        <td class="mono" style="font-size:11px;color:var(--dim)"><%= o.time ? new Date(o.time*1000).toLocaleString() : '' %></td>
      </tr>
      <% }) %>
      <% if (!feed || feed.length===0) { %>
        <tr><td colspan="6" class="empty"><%= t('ops.empty') %></td></tr>
      <% } %>
    </tbody>
  </table>
  <%- include('includes/_pager') %>
</div>
