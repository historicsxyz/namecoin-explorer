<div class="topbar"><h1><%- include('includes/_icon', {icon:'chart'}) %> <%= t('stats.title') %></h1></div>

<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>

<div class="grid cols-4" style="margin-bottom:18px">
  <div class="stat"><%- include('includes/_icon', {icon:'tag'}) %><div class="n"><%= stats.totalNames!=null?nfmt(stats.totalNames):'—' %></div><div class="l"><%= t('stats.totalNames') %></div></div>
  <div class="stat"><%- include('includes/_icon', {icon:'check'}) %><div class="n" style="color:var(--green)"><%= stats.liveNames!=null?nfmt(stats.liveNames):'—' %></div><div class="l"><%= t('stats.live') %></div></div>
  <div class="stat"><%- include('includes/_icon', {icon:'clock'}) %><div class="n" style="color:var(--red)"><%= stats.expiredNames!=null?nfmt(stats.expiredNames):'—' %></div><div class="l"><%= t('stats.expired') %></div></div>
  <div class="stat"><%- include('includes/_icon', {icon:'blocks'}) %><div class="n"><%= stats.chain && stats.chain.blocks ? nfmt(stats.chain.blocks) : '—' %></div><div class="l"><%= t('stats.blockHeight') %></div></div>
</div>

<div class="panel">
  <h2><%- include('includes/_icon', {icon:'layers'}) %> <%= t('stats.namespaces') %></h2>
  <table>
    <thead><tr><th><%= t('stats.prefix') %></th><th><%= t('stats.total') %></th><th><%= t('stats.live') %></th><th><%= t('stats.expired') %></th><th><%= t('stats.livePct') %></th></tr></thead>
    <tbody>
      <% (stats.namespaces||[]).slice(0,25).forEach(r => { %>
      <tr>
        <td class="mono"><a href="/namespace/<%= r.namespace.replace(/\/$/,'') %>"><%= r.namespace %></a></td>
        <td><%= nfmt(r.total) %></td>
        <td style="color:var(--green)"><%= nfmt(r.live||0) %></td>
        <td style="color:var(--red)"><%= nfmt(r.expired||0) %></td>
        <td class="mono"><%= r.total? (100*(r.live||0)/r.total).toFixed(1) : '0' %>%</td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
