<!DOCTYPE html>
<% const seo = locals.seo || { title: 'Namecoin Explorer', description: '', canonical: '', image: '/og.png', imageAlt: 'Namecoin Explorer', noindex: false, ogType: 'website', lang: typeof lang !== 'undefined' ? lang : 'en', locale: 'en_US', localeAlt: 'de_DE', themeColor: '#6787B7', hreflang: [], jsonLd: null }; %>
<html lang="<%= seo.lang || (typeof lang !== 'undefined' ? lang : 'en') %>" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <meta name="application-name" content="<%= seo.siteName || 'Namecoin Explorer' %>">
  <meta name="color-scheme" content="light dark">
  <meta name="robots" content="<%= seo.noindex ? 'noindex, nofollow' : 'index, follow' %>">
  <% if (seo.canonical) { %><link rel="canonical" href="<%= seo.canonical %>"><% } %>
  <% (seo.hreflang || []).forEach(function (h) { %>
  <link rel="alternate" hreflang="<%= h.lang %>" href="<%= h.href %>">
  <% }); %>
  <meta name="theme-color" content="<%= seo.themeColor || '#6787B7' %>">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.png" type="image/png" sizes="100x100">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="200x200">
  <link rel="manifest" href="/site.webmanifest">
  <meta property="og:type" content="<%= seo.ogType || 'website' %>">
  <meta property="og:site_name" content="<%= seo.siteName || 'Namecoin Explorer' %>">
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <% if (seo.canonical) { %><meta property="og:url" content="<%= seo.canonical %>"><% } %>
  <meta property="og:image" content="<%= seo.image %>">
  <meta property="og:image:alt" content="<%= seo.imageAlt || seo.title %>">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="<%= seo.imageWidth || 1200 %>">
  <meta property="og:image:height" content="<%= seo.imageHeight || 630 %>">
  <meta property="og:locale" content="<%= seo.locale || 'en_US' %>">
  <meta property="og:locale:alternate" content="<%= seo.localeAlt || 'de_DE' %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <meta name="twitter:image" content="<%= seo.image %>">
  <meta name="twitter:image:alt" content="<%= seo.imageAlt || seo.title %>">
  <% if (seo.jsonLd) { %>
  <script type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
  <link rel="stylesheet" href="/css/explorer.css?v=38">
  <script>
    try {
      var savedTheme = localStorage.getItem('nmc-theme');
      if (savedTheme === 'dark' || savedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip-link" href="#content"><%= t('aria.skip') %></a>
  <!-- mobile header / app bar (mobile only) -->
  <header class="mobile-header">
    <button id="menu-btn" class="mh-btn" type="button" aria-label="<%= t('aria.menu') %>">☰</button>
    <a href="/" class="mh-title" aria-label="<%= t('app.title') %>"><%- include('includes/_logo', {}) %></a>
    <button id="theme-btn" class="mh-btn" type="button" data-theme-toggle aria-label="<%= t('aria.theme') %>">
      <%- include('includes/_icon', {icon:'sun'}) %>
      <%- include('includes/_icon', {icon:'moon'}) %>
    </button>
  </header>

  <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

  <div class="shell">
  <aside class="sidebar" id="sidebar">
    <a href="/" class="brand" aria-label="<%= t('app.title') %>"><%- include('includes/_logo', {}) %></a>
    <nav class="nav" aria-label="<%= t('nav.primary') %>">
      <a class="<%= locals.page==='home'?'active':'' %>" href="/"><%- include('includes/_icon', {icon:'compass'}) %><span><%= t('nav.home') %></span></a>
      <a class="<%= locals.page==='names'?'active':'' %>" href="/names"><%- include('includes/_icon', {icon:'search'}) %><span><%= t('nav.names') %></span></a>
      <a class="<%= locals.page==='operations'?'active':'' %>" href="/operations"><%- include('includes/_icon', {icon:'activity'}) %><span><%= t('nav.operations') %></span></a>
      <a class="<%= locals.page==='blocks'?'active':'' %>" href="/blocks"><%- include('includes/_icon', {icon:'blocks'}) %><span><%= t('nav.blocks') %></span></a>
      <a class="<%= locals.page==='stats'?'active':'' %>" href="/stats"><%- include('includes/_icon', {icon:'chart'}) %><span><%= t('nav.stats') %></span></a>
      <a class="<%= locals.page==='api'?'active':'' %>" href="/api/stats"><%- include('includes/_icon', {icon:'code'}) %><span><%= t('nav.api') %></span></a>
    </nav>
    <div class="sidebar-dock">
      <div class="status-box">
        <div class="status-cell">
          <span class="k"><%- include('includes/_icon', {icon:'blocks'}) %> <%= t('status.block') %></span>
          <span class="v" id="block-n">0</span>
        </div>
        <div class="status-cell">
          <span class="k"><%- include('includes/_icon', {icon:'tag'}) %> <%= t('status.names') %></span>
          <span class="v" id="name-n">0</span>
        </div>
        <div class="status-cell">
          <span class="k"><%- include('includes/_icon', {icon:'layers'}) %> <%= t('status.chain') %></span>
          <span class="v" id="chain"><%= (locals.chainInfo&&locals.chainInfo.chain)||'-' %></span>
        </div>
        <div class="status-cell">
          <span class="k"><%- include('includes/_icon', {icon: (locals.chainInfo&&locals.chainInfo.initialblockdownload) ? 'clock' : 'check'}) %> <%= t('status.sync') %></span>
          <span class="v" id="sync"><%= (locals.chainInfo&&locals.chainInfo.initialblockdownload)?t('status.syncing'):t('status.ready') %></span>
        </div>
      </div>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="<%= t('aria.theme') %>">
        <%- include('includes/_icon', {icon:'sun'}) %>
        <%- include('includes/_icon', {icon:'moon'}) %>
        <span><%= t('aria.theme') %></span>
      </button>
    </div>
  </aside>
  <main class="main" id="content">
    <div class="search">
      <input type="text" placeholder="<%= t('search.placeholder') %>">
      <div class="search-results" style="display:none"></div>
    </div>
    <%- body %>
    <footer class="site-footer">
      <p class="site-footer-brand">
        <span><%= t('footer.sponsored') %></span>
        <a href="https://historics.xyz" rel="noopener" target="_blank">Historics.xyz</a>
        <span aria-hidden="true">-</span>
        <a href="https://x.com/0xSchatz" rel="noopener" target="_blank">@0xSchatz</a>
      </p>
      <nav class="site-footer-links">
        <a href="https://github.com/historicsxyz/namecoin-explorer" rel="noopener" target="_blank">
          <%- include('includes/_icon', {icon:'github'}) %>
          <%= t('footer.github') %>
        </a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/historicsxyz/namecoin-explorer/blob/main/LICENSE" rel="noopener" target="_blank"><%= t('footer.license') %></a>
        <span aria-hidden="true">·</span>
        <a href="/og"><%= t('footer.og') %></a>
        <span aria-hidden="true">·</span>
        <a class="footer-ver" href="https://github.com/historicsxyz/namecoin-explorer/releases/tag/v<%= typeof appVersion !== 'undefined' ? appVersion : '0.0.4' %>" rel="noopener" target="_blank">v<%= typeof appVersion !== 'undefined' ? appVersion : '0.0.4' %></a>
        <span aria-hidden="true">·</span>
        <span>© <%= new Date().getFullYear() %></span>
      </nav>
    </footer>
  </main>
  </div>

  <script>
    // ---------- mobile drawer / menu ----------
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const menuBtn = document.getElementById('menu-btn');
    if (sidebar && backdrop && menuBtn) {
      const open = () => {
        sidebar.classList.add('open');
        backdrop.classList.add('show');
        document.body.style.overflow = 'hidden';   // lock scroll behind drawer
      };
      const close = () => {
        sidebar.classList.remove('open');
        backdrop.classList.remove('show');
        document.body.style.overflow = '';
      };
      menuBtn.addEventListener('click', () => sidebar.classList.contains('open') ? close() : open());
      backdrop.addEventListener('click', close);
      // close after navigating (mobile)
      sidebar.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
      // close on resize if going desktop
      window.addEventListener('resize', () => { if (window.innerWidth > 900) close(); });
    }

    // ---------- table scroll wrapper (mobile) ----------
    // Wrap every bare <table> in a horizontal-scroll container so long
    // tables don't blow up the viewport on phones.
    (function wrapTables() {
      try {
        document.querySelectorAll('table').forEach((t) => {
          if (!t.parentNode) return;
          if (t.parentElement && t.parentElement.classList.contains('table-wrap')) return;
          const w = document.createElement('div');
          w.className = 'table-wrap';
          t.parentNode.insertBefore(w, t);
          w.appendChild(t);
        });
      } catch (e) {}
    })();

    (function rowLinks() {
      try {
        document.querySelectorAll('tr[data-href]').forEach((tr) => {
          tr.addEventListener('click', (e) => {
            if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            if (e.target.closest('a')) return;
            const href = tr.getAttribute('data-href');
            if (href) window.location.href = href;
          });
        });
      } catch (e) {}
    })();

    // ---------- theme ----------
    (function theme() {
      const root = document.documentElement;
      const KEY = 'nmc-theme';
      const read = () => {
        try { return localStorage.getItem(KEY); } catch (e) { return null; }
      };
      const write = (name) => {
        try { localStorage.setItem(KEY, name); } catch (e) {}
      };
      const apply = (name) => {
        const next = name === 'dark' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        write(next);
      };
      apply(read() || root.getAttribute('data-theme') || 'light');
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          apply(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        });
      });
    })();

    // ---------- status ----------
    const chain = <%= JSON.stringify((locals.chainInfo||{}).blocks||0) %>;
    const names = <%= JSON.stringify(locals.registryCount||0) %>;
    if (document.getElementById('block-n')) document.getElementById('block-n').textContent = chain.toLocaleString();
    if (document.getElementById('name-n')) document.getElementById('name-n').textContent = names.toLocaleString();

    // ---------- live search ----------
    const sinput = document.querySelector('.search input');
    const sresults = document.querySelector('.search-results');
    if (sinput && sresults) {
      let timer;
      sinput.addEventListener('input', () => {
        clearTimeout(timer);
        const q = sinput.value.trim();
        if (q.length < 2) { sresults.innerHTML=''; sresults.style.display='none'; return; }
        timer = setTimeout(async () => {
          try {
            const r = await fetch('/api/search?q=' + encodeURIComponent(q));
            const j = await r.json();
            sresults.innerHTML = (j.items||[]).map(i=>`<a href="/name/${encodeURIComponent(i.name)}">${i.name}</a>`).join('') || <%- JSON.stringify('<div class="empty">' + t('search.noMatch') + '</div>') %>;
            sresults.style.display = 'block';
          } catch(e) {}
        }, 250);
      });
      sinput.addEventListener('keydown', (e)=>{ if(e.key==='Escape'||e.key==='Enter'){ sresults.style.display='none'; }});
    }
  </script>
</body>
</html>