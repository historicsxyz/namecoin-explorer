<% if (decoded && decoded.kind === 'list' && decoded.items && decoded.items.length) { %>
  <ol class="value-list<%= typeof compact !== 'undefined' && compact ? ' compact' : '' %>">
    <% decoded.items.forEach(item => { %>
    <li><% if (item.isObject) { %><div class="value"><%= item.value %></div><% } else { %><span class="mono"><%= item.value %></span><% } %></li>
    <% }) %>
  </ol>
<% } else if (decoded && decoded.kind === 'json' && decoded.table && decoded.table.length) { %>
  <div class="dl<%= typeof compact !== 'undefined' && compact ? ' compact' : '' %>">
    <% decoded.table.forEach(row => { %>
      <dt class="mono"><%= row.label %></dt>
      <dd><% if (row.isObject) { %><div class="value"><%= row.value %></div><% } else { %><span class="mono"><%= row.value %></span><% } %></dd>
    <% }) %>
  </div>
<% } else if (decoded && decoded.raw) { %>
  <div class="value"><%= decoded.raw %></div>
<% } else if (typeof fallback !== 'undefined' && fallback) { %>
  <div class="value"><%= fallback %></div>
<% } %>
