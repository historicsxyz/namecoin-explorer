<div class="topbar"><h1><%- include('includes/_icon', {icon:'activity'}) %> Pending Name Operations</h1><span class="crumb">unconfirmed name operations in the mempool</span></div>

<%- include('includes/_infonote', { note: 'These are the <strong>name operations only</strong> that are waiting unconfirmed in the node\'s mempool — a filtered subset of all unconfirmed transactions. Name ops clear the mempool quickly once mined; the confirmed record is in the <a href="/operations">Name Operations</a> feed.' }) %>

<div class="filterbar">
  <div class="mono" style="font-size:11px;color:var(--muted);align-self:center">
    mempool: <%= (mempoolInfo && mempoolInfo.size != null) ? mempoolInfo.size + ' tx(s)' : '…' %> ·
    <%= (pending||[]).length %> name operation(s) pending ·
    updated <%= now ? new Date(now).toLocaleTimeString() : '' %>
  </div>
</div>

<div class="panel">
  <table>
    <thead><tr><th>Name</th><th>Operation</th><th>Value</th></tr></thead>
    <tbody>
      <% (pending||[]).forEach(p => { %>
        <tr>
          <td class="mono"><a href="/name/<%= encodeURIComponent(p.name) %>"><%= p.name %></a></td>
          <td><span class="pill <%= p.op==='NAME_NEW'?'purple':p.op==='NAME_FIRSTUPDATE'?'blue':'yellow' %>"><%= p.op %></span></td>
          <td class="mono" style="max-width:300px;word-break:break-all;white-space:pre-wrap"><%= String(p.value||'') %></td>
        </tr>
      <% }) %>
      <% if (!pending || pending.length===0) { %>
        <tr><td colspan="3" class="empty">
          <%= (mempoolInfo && mempoolInfo.size > 0) ?
              'The mempool has transactions, but none of them are name operations right now (they clear quickly once mined).' :
              'The mempool is empty — there are no unconfirmed transactions at all right now.' %>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>