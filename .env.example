# HTTP (use http://127.0.0.1:3100 — IPv4 bind, not localhost/::1)
NMC_EXPLORER_PORT=3100
NMC_BIND=127.0.0.1

# Public HTTPS origin for canonical / Open Graph / sitemap URLs.
# Behind Caddy the app can also infer this from X-Forwarded-Proto + Host.
# NMC_PUBLIC_URL=https://nmc.historics.xyz

# namecoind JSON-RPC (leave NMC_RPC_PASS empty to use the cookie file)
NMC_RPC_HOST=127.0.0.1
NMC_RPC_PORT=8336
NMC_RPC_USER=hermes
NMC_RPC_PASS=
NMC_COOKIE_PATH=/var/lib/namecoin/.cookie

# Local UX against a remote node: do NOT open RPC to the internet.
# ssh -N -L 18336:127.0.0.1:8336 nmc-vps
# then set NMC_RPC_PORT=18336 and use the VPS rpcuser/rpcpassword.
# Helper: npm run dev:vps  (scripts/dev-vps.ps1)

# SQLite index (one writer). Point at a fast disk for a large registry.
NMC_CACHE_DB=./data/cache.db

# Optional: subscribe to namecoind hashblock ZMQ for sub-block ingest latency.
# Keep zmqpubhashblock=tcp://127.0.0.1:28332 in namecoin.conf. The 10s poll stays as watchdog.
# Requires: npm install zeromq
# NMC_ZMQ_HASHBLOCK=tcp://127.0.0.1:28332

# Optional: first run from height 0 instead of tip-36000. Needs txindex=1.
# Slow; one ingest process only. Delete cache.db to re-index.
# NMC_INGEST_FROM=0
# NMC_INGEST_FROM=genesis

# Stats page NMC/USD (CoinPaprika, CoinGecko fallback). No API key.
# Set 0 on an air-gapped host.
# NMC_MARKET=0

# In-process rate limits (search / API / stats). Set 0 if Caddy already limits.
# NMC_RATE_LIMIT=0

# Abort stuck HTTP handlers (ms). Default 60000.
# NMC_REQUEST_TIMEOUT_MS=60000
