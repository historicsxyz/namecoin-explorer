{
  "name": "namecoin-explorer",
  "version": "0.0.2",
  "description": "Self-hosted Namecoin name browser and operations explorer. SQLite index, JSON API, backed by your own namecoind.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "dev:vps": "powershell -File scripts/dev-vps.ps1",
    "check": "node --check app.js",
    "test": "node --test"
  },
  "keywords": [
    "namecoin",
    "nmc",
    "blockchain",
    "explorer",
    "dns",
    "names",
    "block-explorer",
    "open-source"
  ],
  "author": "historicsxyz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/historicsxyz/namecoin-explorer.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "bulma": "^1.0.4",
    "compression": "^1.7.4",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "optionalDependencies": {
    "zeromq": "^6.4.2"
  }
}